<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Watch Search Gateway</title>
</head>
<body>
  <div id="result">Ricerca in corso...</div>

  <script>
    async function search() {
      const urlParams = new URLSearchParams(window.location.search);
      const query = urlParams.get('q');

      if (!query) {
        document.getElementById('result').innerText = "Errore: Inserisci il parametro ?q=termine";
        return;
      }

      try {
        // Usa l'API Instant Answer di DuckDuckGo per estrarre la sintesi
        const response = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`);
        const data = await response.json();

        let output = "";

        if (data.AbstractText) {
          output = data.AbstractText;
        } else if (data.Definition) {
          output = data.Definition;
        } else if (data.RelatedTopics && data.RelatedTopics.length > 0 && data.RelatedTopics[0].Text) {
          output = data.RelatedTopics[0].Text;
        } else {
          output = "Nessun risultato sintetico trovato per: " + query;
        }

        // Se l'app necessita di un JSON pulito, restituiamo o mostriamo solo il testo
        document.body.innerText = output;

      } catch (err) {
        document.body.innerText = "Errore durante il recupero dei dati.";
      }
    }

    search();
  </script>
</body>
</html>
